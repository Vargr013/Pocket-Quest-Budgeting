rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    // I used the same trimmed display text and lowercase key as the client (Google, 2020).
    function nameKey(name) { return 'n:' + name.lower(); }
    function stableId(id) { return id.matches('[A-Za-z0-9_-]{1,80}'); }
    function mutationId(id) { return id.matches('[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}'); }
    function recordPath(uid, type, id) { return /databases/$(database)/documents/users/$(uid)/$(type)/$(id); }
    function categoryPath(uid, id) { return /databases/$(database)/documents/users/$(uid)/categories/$(id); }
    function receiptPath(uid, id) { return /databases/$(database)/documents/users/$(uid)/mutations/$(id); }
    function indexPath(uid) { return /databases/$(database)/documents/users/$(uid)/categoryNames/index; }
    function setupFields(data) {
      return data.keys().hasAll(['schemaVersion', 'username', 'categoriesInitialized'])
        && data.keys().hasOnly(['schemaVersion', 'username', 'categoriesInitialized'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.username is string && data.username.size() > 0 && data.categoriesInitialized is bool;
    }
    function validCategory(data) {
      // I checked the exact fields and integer cents before accepting a category (Google, 2026p).
      return data.keys().hasAll(['name', 'minimumCents', 'maximumCents', 'schemaVersion', 'revision', 'lastMutationId', 'updatedAt', 'isDeleted', 'deletedAt'])
        && data.keys().hasOnly(['name', 'minimumCents', 'maximumCents', 'schemaVersion', 'revision', 'lastMutationId', 'updatedAt', 'isDeleted', 'deletedAt'])
        && data.name is string && data.name.size() > 0 && data.name.trim() == data.name
        && data.minimumCents is int && data.maximumCents is int
        && data.minimumCents >= 0 && data.maximumCents >= data.minimumCents
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.revision is int && data.revision > 0
        && mutationId(data.lastMutationId) && data.updatedAt == request.time
        && data.isDeleted is bool
        && (data.isDeleted ? data.deletedAt == request.time : data.deletedAt == null);
    }
    function matchingReceipt(uid, id, data, base, type) {
      let path = receiptPath(uid, data.lastMutationId);
      let receipt = getAfter(path).data;
      // I required a new receipt in the same atomic write (Google, 2026z).
      return !exists(path) && receipt.recordType == type && receipt.recordId == id
        && receipt.baseRevision == base && receipt.revision == data.revision;
    }
    function matchingIndex(uid, id, data) {
      let index = getAfter(indexPath(uid)).data;
      return index.recordId == id && index.lastMutationId == data.lastMutationId
        && (data.isDeleted ? index.names.get(nameKey(data.name), '') != id : index.names.get(nameKey(data.name), '') == id);
    }
    function defaultRecord(uid, id, name) {
      let data = getAfter(categoryPath(uid, id)).data;
      return data.name == name && data.minimumCents == 0 && data.maximumCents == 0
        && data.revision == 1 && !data.isDeleted;
    }
    function defaultIndex(uid, id, data) {
      let index = getAfter(indexPath(uid)).data;
      return !exists(indexPath(uid)) && index.recordId == 'defaults' && index.lastMutationId == ''
        && id in ['default-groceries', 'default-transport', 'default-entertainment', 'default-rent']
        && data.minimumCents == 0 && data.maximumCents == 0 && !data.isDeleted
        && index.names.get(nameKey(data.name), '') == id;
    }
    function setupComplete(uid) {
      return existsAfter(indexPath(uid));
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && setupFields(request.resource.data)
        && (!request.resource.data.categoriesInitialized || setupComplete(uid));
      allow update: if isOwner(uid) && setupFields(request.resource.data)
        && request.resource.data.username == resource.data.username
        && (!resource.data.categoriesInitialized || request.resource.data.categoriesInitialized)
        && (!request.resource.data.categoriesInitialized || setupComplete(uid));
      allow list, delete: if false;
    }
    match /users/{uid}/categories/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && stableId(id) && validCategory(request.resource.data)
        && request.resource.data.revision == 1
        && matchingReceipt(uid, id, request.resource.data, 0, 'categories')
        && (matchingIndex(uid, id, request.resource.data) || defaultIndex(uid, id, request.resource.data));
      allow update: if isOwner(uid) && validCategory(request.resource.data) && !resource.data.isDeleted
        && request.resource.data.revision == resource.data.revision + 1
        && (!request.resource.data.isDeleted || (request.resource.data.name == resource.data.name
          && request.resource.data.minimumCents == resource.data.minimumCents
          && request.resource.data.maximumCents == resource.data.maximumCents))
        && matchingReceipt(uid, id, request.resource.data, resource.data.revision, 'categories')
        && matchingIndex(uid, id, request.resource.data);
      allow delete: if false;
    }
    function validExpenseDate(date) {
      let year = int(date[0:4]);
      let month = int(date[5:7]);
      let day = int(date[8:10]);
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      let days = month == 2 ? (leap ? 29 : 28) : (month in [4, 6, 9, 11] ? 30 : 31);
      return date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && year > 0
        && month >= 1 && month <= 12 && day >= 1 && day <= days;
    }
    function validExpense(data) {
      // I kept expense fields explicit and rejected local photo paths (Google, 2026p).
      return data.keys().hasAll(['categoryId', 'amountCents', 'date', 'startTime', 'endTime', 'description', 'receiptObjectPath',
          'schemaVersion', 'revision', 'lastMutationId', 'updatedAt', 'isDeleted', 'deletedAt'])
        && data.keys().hasOnly(['categoryId', 'amountCents', 'date', 'startTime', 'endTime', 'description', 'receiptObjectPath',
          'schemaVersion', 'revision', 'lastMutationId', 'updatedAt', 'isDeleted', 'deletedAt'])
        && data.categoryId is string && stableId(data.categoryId)
        && data.amountCents is int && data.amountCents > 0
        && data.date is string && validExpenseDate(data.date)
        && data.startTime is string && data.startTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && data.endTime is string && data.endTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && data.endTime >= data.startTime
        && data.description is string && data.description.size() > 0 && data.description.trim() == data.description
        && (data.receiptObjectPath == null || data.receiptObjectPath is string)
        && data.schemaVersion is int && data.schemaVersion == 1 && data.revision is int && data.revision > 0
        && mutationId(data.lastMutationId) && data.updatedAt == request.time && data.isDeleted is bool
        && (data.isDeleted ? data.deletedAt == request.time : data.deletedAt == null);
    }
    function allowedExpenseCategory(uid, id, data) {
      let category = getAfter(categoryPath(uid, data.categoryId)).data;
      // I checked the final category state so one batch could not archive it and add a new expense (Google, 2026z).
      return category.isDeleted == false || data.isDeleted
        || (exists(recordPath(uid, 'expenses', id)) && get(recordPath(uid, 'expenses', id)).data.categoryId == data.categoryId);
    }
    function objectGuard(uid, path) {
      return /databases/$(database)/documents/users/$(uid)/receiptObjects/$(path.split('/')[4]);
    }
    function validObjectPath(uid, expense, path) {
      return path is string && path.split('/').size() == 5
        && path == 'users/' + uid + '/receipts/' + expense + '/' + path.split('/')[4]
        && mutationId(expense) && mutationId(path.split('/')[4]);
    }
    function changedObject(uid, expense, path, state, mutation) {
      let data = getAfter(objectGuard(uid, path)).data;
      return validObjectPath(uid, expense, path) && data.objectPath == path
        && data.expenseCloudId == expense && data.state == state
        && data.lastExpenseMutationId == mutation && data.updatedAt == request.time;
    }
    function expensePhotoChange(uid, id, old, data) {
      return (old == data.receiptObjectPath && !data.isDeleted)
        || ((old == null || changedObject(uid, id, old, 'RETIRED', data.lastMutationId))
          && (data.isDeleted || data.receiptObjectPath == null
            || changedObject(uid, id, data.receiptObjectPath, 'PUBLISHED', data.lastMutationId)));
    }
    function validObject(uid, id, data) {
      return data.keys().hasAll(['schemaVersion', 'expenseCloudId', 'objectPath', 'state', 'createdAt', 'updatedAt', 'lastExpenseMutationId'])
        && data.keys().hasOnly(['schemaVersion', 'expenseCloudId', 'objectPath', 'state', 'createdAt', 'updatedAt', 'lastExpenseMutationId'])
        && data.schemaVersion is int && data.schemaVersion == 1 && mutationId(id)
        && validObjectPath(uid, data.expenseCloudId, data.objectPath)
        && data.objectPath.split('/')[4] == id && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /users/{uid}/receiptObjects/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validObject(uid, id, request.resource.data)
        && request.resource.data.state == 'STAGED' && request.resource.data.createdAt == request.time
        && request.resource.data.lastExpenseMutationId == null
        && !get(recordPath(uid, 'expenses', request.resource.data.expenseCloudId)).data.isDeleted;
      // I retired each path permanently before allowing file cleanup (Google, 2026z).
      allow update: if isOwner(uid) && validObject(uid, id, request.resource.data)
        && request.resource.data.expenseCloudId == resource.data.expenseCloudId
        && request.resource.data.objectPath == resource.data.objectPath
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.state == 'STAGED' && request.resource.data.state == 'RETIRED'
          && request.resource.data.lastExpenseMutationId == null
          && getAfter(recordPath(uid, 'expenses', resource.data.expenseCloudId)).data.receiptObjectPath != resource.data.objectPath
          || objectTransition(uid, resource.data, request.resource.data));
      allow delete: if false;
    }
    function objectTransition(uid, old, data) {
      let before = get(recordPath(uid, 'expenses', old.expenseCloudId)).data;
      let after = getAfter(recordPath(uid, 'expenses', old.expenseCloudId)).data;
      return mutationId(data.lastExpenseMutationId) && after.lastMutationId == data.lastExpenseMutationId
        && after.revision == before.revision + 1 && !before.isDeleted
        && (old.state == 'STAGED' && data.state == 'PUBLISHED' && !after.isDeleted && after.receiptObjectPath == old.objectPath
          || old.state == 'PUBLISHED' && data.state == 'RETIRED' && before.receiptObjectPath == old.objectPath
            && (after.isDeleted || after.receiptObjectPath != old.objectPath));
    }
    match /users/{uid}/expenses/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && stableId(id) && validExpense(request.resource.data)
        && request.resource.data.revision == 1 && request.resource.data.receiptObjectPath == null
        && allowedExpenseCategory(uid, id, request.resource.data)
        && matchingReceipt(uid, id, request.resource.data, 0, 'expenses');
      allow update: if isOwner(uid) && validExpense(request.resource.data) && !resource.data.isDeleted
        && request.resource.data.revision == resource.data.revision + 1
        && expensePhotoChange(uid, id, resource.data.receiptObjectPath, request.resource.data)
        && (!request.resource.data.isDeleted || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['revision', 'lastMutationId', 'updatedAt', 'isDeleted', 'deletedAt']))
        && allowedExpenseCategory(uid, id, request.resource.data)
        && matchingReceipt(uid, id, request.resource.data, resource.data.revision, 'expenses');
      allow delete: if false;
    }
    function validMonthlyGoal(id, data) {
      let year = int(id[0:4]);
      let month = int(id[5:7]);
      let leap = year % 4 == 0 && (year % 100 != 0 || year % 400 == 0);
      let last = month == 2 ? (leap ? '29' : '28') : (month in [4, 6, 9, 11] ? '30' : '31');
      // I tied both calendar dates to the document month and kept the limits as integer cents (Google, 2026p).
      return id.matches('[0-9]{4}-(0[1-9]|1[0-2])') && year > 0
        && data.keys().hasAll(['minimumCents', 'maximumCents', 'startDate', 'endDate',
          'schemaVersion', 'revision', 'lastMutationId', 'updatedAt', 'isDeleted', 'deletedAt'])
        && data.keys().hasOnly(['minimumCents', 'maximumCents', 'startDate', 'endDate',
          'schemaVersion', 'revision', 'lastMutationId', 'updatedAt', 'isDeleted', 'deletedAt'])
        && data.minimumCents is int && data.maximumCents is int
        && data.minimumCents >= 0 && data.maximumCents >= data.minimumCents
        && data.startDate is string && data.startDate == id + '-01'
        && data.endDate is string && data.endDate == id + '-' + last
        && data.schemaVersion is int && data.schemaVersion == 1 && data.revision is int && data.revision > 0
        && mutationId(data.lastMutationId) && data.updatedAt == request.time && data.isDeleted is bool
        && (data.isDeleted ? data.deletedAt == request.time : data.deletedAt == null);
    }
    match /users/{uid}/monthlyGoals/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validMonthlyGoal(id, request.resource.data)
        && request.resource.data.revision == 1
        && matchingReceipt(uid, id, request.resource.data, 0, 'monthlyGoals');
      allow update: if isOwner(uid) && validMonthlyGoal(id, request.resource.data) && !resource.data.isDeleted
        && request.resource.data.revision == resource.data.revision + 1
        && (!request.resource.data.isDeleted || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['revision', 'lastMutationId', 'updatedAt', 'isDeleted', 'deletedAt']))
        && matchingReceipt(uid, id, request.resource.data, resource.data.revision, 'monthlyGoals');
      allow delete: if false;
    }
    match /users/{uid}/mutations/{id} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && mutationId(id)
        && request.resource.data.keys().hasAll(['recordType', 'recordId', 'baseRevision', 'revision', 'fingerprint'])
        && request.resource.data.keys().hasOnly(['recordType', 'recordId', 'baseRevision', 'revision', 'fingerprint'])
        && request.resource.data.recordType in ['categories', 'expenses', 'monthlyGoals'] && stableId(request.resource.data.recordId)
        && request.resource.data.baseRevision is int && request.resource.data.baseRevision >= 0
        && request.resource.data.revision is int && request.resource.data.revision == request.resource.data.baseRevision + 1
        && request.resource.data.fingerprint is string && request.resource.data.fingerprint.matches('[a-f0-9]{64}')
        && getAfter(recordPath(uid, request.resource.data.recordType, request.resource.data.recordId)).data.lastMutationId == id
        && getAfter(recordPath(uid, request.resource.data.recordType, request.resource.data.recordId)).data.revision == request.resource.data.revision
        && (exists(recordPath(uid, request.resource.data.recordType, request.resource.data.recordId))
          ? get(recordPath(uid, request.resource.data.recordType, request.resource.data.recordId)).data.revision == request.resource.data.baseRevision
          : request.resource.data.baseRevision == 0);
      allow update, delete: if false;
    }
    function validIndex(uid, data, oldNames) {
      let id = data.recordId;
      let record = getAfter(categoryPath(uid, id)).data;
      let old = exists(categoryPath(uid, id)) ? nameKey(get(categoryPath(uid, id)).data.name) : nameKey(record.name);
      let key = nameKey(record.name);
      return data.keys().hasAll(['names', 'recordId', 'lastMutationId'])
        && data.keys().hasOnly(['names', 'recordId', 'lastMutationId']) && data.names is map
        && stableId(id) && mutationId(data.lastMutationId) && record.lastMutationId == data.lastMutationId
        && !exists(receiptPath(uid, data.lastMutationId)) && existsAfter(receiptPath(uid, data.lastMutationId))
        && data.names.diff(oldNames).affectedKeys().hasOnly([old, key])
        && (record.isDeleted ? data.names.get(key, '') != id : data.names.get(key, '') == id)
        && (record.isDeleted || oldNames.get(key, id) == id)
        && (old == key || !(old in data.names));
    }
    function initialIndex(uid, data) {
      let setup = /databases/$(database)/documents/users/$(uid);
      return data.keys().hasAll(['names', 'recordId', 'lastMutationId'])
        && data.keys().hasOnly(['names', 'recordId', 'lastMutationId']) && data.lastMutationId == ''
        && getAfter(setup).data.categoriesInitialized == true
        && (data.recordId == 'initialized' && data.names == {}
          || data.recordId == 'defaults' && (!exists(setup) || get(setup).data.categoriesInitialized == false)
            && data.names == {'n:groceries': 'default-groceries', 'n:transport': 'default-transport',
              'n:entertainment': 'default-entertainment', 'n:rent': 'default-rent'}
            && defaultRecord(uid, 'default-groceries', 'Groceries')
            && defaultRecord(uid, 'default-transport', 'Transport')
            && defaultRecord(uid, 'default-entertainment', 'Entertainment')
            && defaultRecord(uid, 'default-rent', 'Rent'));
    }
    match /users/{uid}/categoryNames/index {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && (initialIndex(uid, request.resource.data) || validIndex(uid, request.resource.data, {}));
      allow update: if isOwner(uid) && validIndex(uid, request.resource.data, resource.data.names);
      allow list, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
